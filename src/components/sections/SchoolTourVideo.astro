---
import siteData from '../../data/site.json';

const data = siteData.home.tourVideo;
---

<section class="tour-video py-section text-center">
  <div class="container">
    <h2 class="mb-lg">{data.title}</h2>
    <div class="video-container shadow-lg rounded" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 900px; margin: 0 auto;">
      <iframe 
        src={data.videoUrl} 
        title={data.title} 
        frameborder="0" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
        allowfullscreen 
        loading="lazy"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
      </iframe>
    </div>
  </div>
</section>
