---
import siteData from '../../data/site.json';
import Button from '../ui/Button.astro';

const data = siteData.home.facilitiesOverview;
---

<section class="facilities-overview py-section bg-light">
  <div class="container">
    <div class="text-center mb-lg">
      <h2>{data.title}</h2>
    </div>
    <div class="grid grid-4 gap-md mb-lg">
      {data.items.map((facility, index) => (
        <article class="facility-card text-center p-md bg-white rounded shadow-sm hover-lift" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="facility-icon mb-sm" style="font-size: 2rem;">{facility.icon}</div>
          <h3 class="h5 mb-xs">{facility.name}</h3>
          <p class="text-muted text-sm">{facility.desc}</p>
        </article>
      ))}
    </div>
    <div class="text-center">
      <Button href={data.cta.href} variant="outline-primary">{data.cta.label}</Button>
    </div>
  </div>
</section>
