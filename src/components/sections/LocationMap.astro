---
import siteData from '../../data/site.json';

const data = siteData.home.locationMap;
const contact = siteData.contact;
---

<section class="location-map py-section bg-light">
  <div class="container">
    <div class="text-center mb-lg" data-aos="fade-left">
      <h2>{data.title}</h2>
      <p class="text-muted">{contact.address}</p>
    </div>
    
    <div class="map-container shadow-md rounded overflow-hidden" style="width: 100%; max-width: 100%; height: 400px; position: relative;" data-aos="fade-right">
      <iframe 
        src={data.mapEmbed} 
        width="100%" 
        height="100%" 
        style="border:0; position: absolute; top: 0; left: 0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="School Location Map">
      </iframe>
    </div>
  </div>
</section>
