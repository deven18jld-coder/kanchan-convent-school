---
import siteData from '../../data/site.json';
import galleryJsonData from '../../data/gallery.json';
import Button from '../ui/Button.astro';
import { getHybridGalleryImages } from '../../utils/imageLoader';

const data = siteData.home.galleryPreview;
const previewImages = getHybridGalleryImages(galleryJsonData).slice(0, 4);
---

<section class="gallery-preview py-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-lg flex-wrap gap-sm">
      <h2 class="mb-0">{data.title}</h2>
      <Button href={data.cta.href} variant="outline-primary">{data.cta.label}</Button>
    </div>
    
    <div class="grid grid-4 gap-sm">
      {previewImages.map(img => (
        <article class="gallery-item rounded overflow-hidden shadow-sm" style="aspect-ratio: 1; position: relative;">
          <img 
            src={img.url} 
            alt={img.alt} 
            loading="lazy" 
            style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" 
            class="hover-zoom"
          />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .hover-zoom:hover {
    transform: scale(1.05);
  }
</style>
