---
import siteData from '../../data/site.json';

const data = siteData.home.whyChooseUs;
---

<section class="why-choose-us py-section">
  <div class="container">
    <h2 class="text-center mb-lg">{data.title}</h2>
    <div class="grid grid-3 gap-lg">
      {data.items.map(item => (
        <div class="feature-card text-center p-md bg-white rounded shadow-sm hover-lift">
          <div class="feature-icon mb-sm" style="font-size: 2.5rem;">{item.icon}</div>
          <h3 class="h4 mb-xs">{item.title}</h3>
          <p class="text-muted">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
