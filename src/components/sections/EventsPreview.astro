---
import siteData from '../../data/site.json';
import eventsData from '../../data/events.json';
import Button from '../ui/Button.astro';
import { getMatchedImage } from '../../utils/imageLoader';

const data = siteData.home.eventsPreview;
const previewEvents = eventsData.slice(0, 3).map(event => ({
  ...event,
  image: getMatchedImage('events', event.id, event.image)
}));
---

<section class="events-preview py-section bg-light">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-lg flex-wrap gap-sm">
      <h2 class="mb-0">{data.title}</h2>
      <Button href={data.cta.href} variant="outline-primary">{data.cta.label}</Button>
    </div>
    
    <div class="grid grid-3 gap-md">
      {previewEvents.map((event, index) => (
        <article class="event-card bg-white rounded shadow-sm overflow-hidden d-flex flex-column hover-lift" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="event-image" style="height: 200px; overflow: hidden; position: relative;">
            <img src={event.image} alt={event.title} loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
            <div class="event-badge bg-primary text-white text-sm" style="position: absolute; top: 1rem; right: 1rem; padding: 0.25rem 0.75rem; border-radius: 4px; font-weight: 600;">
              {event.category}
            </div>
          </div>
          <div class="event-content p-md d-flex flex-column" style="flex: 1;">
            <div class="event-meta text-muted text-sm mb-xs d-flex align-items-center gap-sm">
              <span>📅 {new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <span>📍 {event.location}</span>
            </div>
            <h3 class="h5 mb-sm">{event.title}</h3>
            <p class="text-muted text-sm mb-md">{event.description}</p>
            <div class="mt-auto">
              <a href={`/events#${event.id}`} class="text-primary text-decoration-none fw-bold">Read More &rarr;</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
