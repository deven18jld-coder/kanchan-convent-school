---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';
import seoData from '../data/seo.json';

const seo = seoData.facilities;
const content = siteData.pages.facilities;
const facilities = siteData.home.facilitiesOverview;

// Expanded details for all facilities to make it premium and highly detailed
const facilityHighlights: Record<string, string[]> = {
  "Science Labs": [
    "Physics, Chemistry, and Biology laboratories",
    "Equipped with modern apparatus and safety measures",
    "Individual workstations for every student",
    "Regular practical experiments guided by specialists"
  ],
  "Library": [
    "Over 10,000 reference books, journals, and fiction titles",
    "Dedicated digital e-learning corner with internet access",
    "Quiet reading zone and study booths",
    "Regular book clubs and storytelling sessions"
  ],
  "Sports Ground": [
    "Full-sized athletic track and football ground",
    "Dedicated basketball, volleyball, and tennis courts",
    "Indoor sports hall for table tennis, chess, and carrom",
    "Professional coaches for specialized training programs"
  ],
  "Transport": [
    "Fleet of modern GPS-enabled school buses",
    "Experienced drivers and trained female conductors",
    "Real-time SMS alerts and location tracking for parents",
    "Strict adherence to government safety regulations"
  ]
};
---

<Layout title={seo.title} description={seo.description}>
  {content.enabled && (
    <>
      {/* Page Header */}
      <section class="page-header">
        <div class="container">
          <h1>{content.title}</h1>
          <p>{content.content}</p>
        </div>
      </section>

      {/* Facilities Grid */}
      {facilities.enabled && (
        <section class="section bg-bg">
          <div class="container">
            <div class="grid grid-2 gap-lg">
              {facilities.items.map((facility) => {
                const highlights = facilityHighlights[facility.name] || [
                  "Modern state-of-the-art facility",
                  "Safe and fully monitored environment",
                  "Guided by certified instructors",
                  "Promoting experiential learning"
                ];

                return (
                  <article class="card bg-surface shadow-md p-xl d-flex flex-column justify-content-between" style="border-top: 4px solid var(--color-primary); height: 100%;">
                    <div>
                      <div class="d-flex align-items-center gap-md mb-md">
                        <span style="font-size: 3rem; line-height: 1;">{facility.icon}</span>
                        <div>
                          <h2 class="mb-xs" style="font-size: 1.5rem; color: var(--color-primary); font-family: var(--font-body); font-weight: 700;">
                            {facility.name}
                          </h2>
                          <p class="mb-0 text-secondary" style="font-size: 0.95rem;">{facility.desc}</p>
                        </div>
                      </div>
                      
                      <div style="background-color: var(--color-bg); padding: var(--spacing-md); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" class="mb-md">
                        <span class="fw-semibold text-primary d-block mb-sm fs-sm">Key Features & Offerings:</span>
                        <ul style="list-style-type: disc; padding-left: 20px; color: var(--color-text-secondary); font-size: 0.9rem;" class="d-flex flex-column gap-xs">
                          {highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="mt-sm">
                      <span class="badge bg-primary text-white px-3 py-2 text-xs">Fully Operational</span>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* Campus Safety Notice */}
      <section class="section bg-surface text-center" style="border-top: 1px solid var(--color-border);">
        <div class="container" style="max-width: 800px;">
          <span style="font-size: 3rem; display: block; margin-bottom: var(--spacing-sm);">🛡️</span>
          <h2 class="mb-md">Campus Safety & Surveillance</h2>
          <p class="text-secondary" style="font-size: 1.1rem; line-height: 1.7;">
            The entire {siteData.school.name} campus is monitored under 24/7 high-definition CCTV security. Fire extinguishers, emergency exit drills, and first-aid rooms with full-time medical nurses are present in the campus for our students' safety.
          </p>
          <div class="mt-lg">
            <a href="/contact" class="btn btn-primary">Schedule a Campus Visit</a>
          </div>
        </div>
      </section>
    </>
  )}
</Layout>
